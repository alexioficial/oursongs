# --- MongoDB ---
# Cadena de conexión. En local: mongodb://127.0.0.1:27017
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=oursongs

# --- Servidor ---
# Origen público de la app. adapter-node lo necesita en producción para validar
# el origen de las peticiones POST.
ORIGIN=http://localhost:5173
PORT=3000

# Zona horaria con la que el servidor formatea las fechas que se muestran.
TZ=America/Santo_Domingo
