# Copia este archivo a .env y ajusta lo que haga falta. En producción las
# variables las inyecta la plataforma (en Coolify, las de la aplicación) y este
# archivo no se usa.

# --- MongoDB ---
# Cadena de conexión. En local: mongodb://127.0.0.1:27017
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=oursongs

# --- Servidor ---
# Origen público de la app. En producción adapter-node lo necesita para componer
# bien las URLs detrás del proxy y para validar el origen de los POST.
ORIGIN=http://localhost:5173

# Solo los usa el build de producción (`bun ./build/index.js`); en desarrollo el
# puerto lo manda vite.
HOST=0.0.0.0
PORT=3000

# Zona horaria con la que el servidor formatea las fechas que se muestran.
TZ=America/Santo_Domingo

# --- Alta de usuarios (opcional) ---
# `bun run create:user` pide la contraseña por consola y hace eco de ella al
# escribirla; ponla aquí si prefieres no dejarla en el historial de la terminal.
# OURSONGS_PASSWORD=
